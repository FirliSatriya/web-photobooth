# ---------------------------------------------------------------------------
# Supabase (auth / realtime signaling / database)
# Leave empty to run in LOCAL DEMO MODE:
#   - rooms are stored in server memory
#   - signaling uses BroadcastChannel (same browser, multiple tabs)
#   - share links live in server memory for 24h
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Public storage bucket used for 24h share links (optional if Supabase is set)
SUPABASE_STORAGE_BUCKET=photobooth-outputs

# ---------------------------------------------------------------------------
# Cloudflare R2 (S3 compatible, optional). Takes priority over Supabase storage.
# ---------------------------------------------------------------------------
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_BASE_URL=

# ---------------------------------------------------------------------------
# WebRTC ICE servers. Comma separated. TURN recommended for strict networks.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_STUN_URLS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302
NEXT_PUBLIC_TURN_URL=
NEXT_PUBLIC_TURN_USERNAME=
NEXT_PUBLIC_TURN_CREDENTIAL=

# ---------------------------------------------------------------------------
# Midtrans Snap (optional). Without keys the Session Pass unlock runs in
# demo mode (instant unlock) so the whole flow can be tested end-to-end.
# ---------------------------------------------------------------------------
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_IS_PRODUCTION=false

NEXT_PUBLIC_APP_URL=http://localhost:3000
